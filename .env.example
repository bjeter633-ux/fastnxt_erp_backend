# ── Email (Railway Free/Hobby: SMTP blocked — use Resend HTTPS API) ──
EMAIL_PROVIDER=your_value_here
RESEND_API_KEY=your_value_here
# If domain not verified yet, use Resend test sender:
EMAIL_FROM=your_value_here
EMAIL_FROM_NAME=your_value_here
EMAIL_REPLY_TO=your_value_here

# ── SMTP (local dev only — Gmail app password) ──
# EMAIL_PROVIDER=your_value_here
# EMAIL_USER=your_value_here
# EMAIL_PASS=your_value_here
# EMAIL_HOST=your_value_here
# EMAIL_PORT=your_value_here
# EMAIL_SECURE=your_value_here

# Web login link in team-invite emails
FRONTEND_URL=your_value_here
# Optional store links (leave empty until published)
ANDROID_APP_URL=your_value_here
IOS_APP_URL=your_value_here

# ── OneSignal (Flutter device push) ──────────────────────────
ONESIGNAL_APP_ID=your_value_here
ONESIGNAL_REST_API_KEY=your_value_here
ONESIGNAL_ENV=your_value_here

# ── App Store / Google Play review demo login (reusable OTP, no email sent) ──
# Comma-separated emails of dedicated reviewer accounts you already created.
DEMO_LOGIN_EMAILS=your_value_here
# Fixed 6-digit OTP the store reviewer will enter after email + password.
DEMO_LOGIN_OTP=your_value_here

# ── Google Play Billing (Android in-app subscriptions) ──
PLAY_PACKAGE_NAME=your_value_here
# Paste the Play Console service-account JSON as one line, or use a file path:
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=your_value_here
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=your_value_here

# ── Apple App Store Billing (iOS In-App Purchase / StoreKit) ──
APPLE_BUNDLE_ID=your_value_here
# App Store Connect → Users and Access → Integrations → In-App Purchase key (.p8)
# APPLE_KEY_ID=your_value_here
# APPLE_ISSUER_ID=your_value_here
# APPLE_PRIVATE_KEY=your_value_here
# Local/dev only (never in production): trust client JWS without Server API
# APPLE_IAP_TRUST_CLIENT_JWS=your_value_here

# ── Server (Railway / local on-prem) ─────────────────────────
# On Railway: do NOT set PORT or HOST in Variables — Railway injects PORT,
# and server.js always binds 0.0.0.0 in production/cloud (avoids 502 dial timeout).
# Local/on-prem only:
PORT=your_value_here
# Optional local bind override (ignored when RAILWAY_* or NODE_ENV=production):
# HOST=your_value_here
NODE_ENV=your_value_here

# Required for JWT auth (generate a long random string; never commit the real value)
JWT_SECRET=your_value_here

# ── Database ─────────────────────────────────────────────────
#
# Option A — Local PostgreSQL (on-prem / Windows server)
# One database per client installation. DIRECT_URL is not required locally.
# DATABASE_URL=your_value_here
#
# Option B — Neon (cloud / Railway production)
# Pooled (has "-pooler" in host) — OK for simple queries
# Do NOT add channel_binding=require — Prisma/Node on macOS often fails with P1001.
DATABASE_URL=your_value_here

# Direct / non-pooler (NO "-pooler" in host) — REQUIRED for migrations
# and for Vercel interactive transactions (bank, bills, products, JE…)
# Neon dashboard → Connection details → "Direct" / "Unpooled"
DIRECT_URL=your_value_here

# Optional: force runtime to always use DIRECT_URL (recommended on Vercel)
# PRISMA_USE_DIRECT=your_value_here

# ── File uploads (Cloudinary) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_value_here
CLOUDINARY_API_KEY=your_value_here
CLOUDINARY_API_SECRET=your_value_here

# ── Backup & Restore (R2 / S3 / local) ───────────────────────
# Platform owners (comma-separated) — required for full DB backups
# PLATFORM_OWNER_EMAILS=your_value_here
#
# Storage: local (default/dev) | r2 | s3
BACKUP_STORAGE_PROVIDER=your_value_here
# BACKUP_LOCAL_DIR=your_value_here
# BACKUP_TMP_DIR=your_value_here
#
# Cloudflare R2 (recommended for production backups — private bucket)
# R2_ACCOUNT_ID=your_value_here
# R2_ACCESS_KEY_ID=your_value_here
# R2_SECRET_ACCESS_KEY=your_value_here
# R2_BACKUP_BUCKET=your_value_here
# R2_ENDPOINT=your_value_here
#
# Or S3-compatible:
# S3_BACKUP_BUCKET=your_value_here
# AWS_ACCESS_KEY_ID=your_value_here
# AWS_SECRET_ACCESS_KEY=your_value_here
# AWS_REGION=your_value_here
# S3_BACKUP_ENDPOINT=your_value_here
#
# Retention & limits
BACKUP_COMPANY_RETENTION_DAYS=your_value_here
BACKUP_FULL_RETENTION_DAYS=your_value_here
BACKUP_MAX_COMPANIES=your_value_here
BACKUP_RATE_LIMIT_MAX=your_value_here
#
# Railway Cron → POST /api/admin/backups/run-scheduled with header X-Cron-Secret
# BACKUP_CRON_SECRET=your_value_here
#
# NEVER enable on production unless you understand the risk:
# BACKUP_ALLOW_FULL_RESTORE=your_value_here
# Optional path if pg_dump is not on PATH:
# PG_DUMP_PATH=your_value_here
# ERP_VERSION=your_value_here

# ── Exchange rates (company-wise currency module) ────────────
# Rates are NEVER invented: they come only from the provider below.
# Unset/empty => the module reports the provider as unconfigured and no
# automatic refresh happens (manually entered rates still work).
# Supported: open-er-api (default) | frankfurter | none
FX_PROVIDER=your_value_here
# Override the provider endpoint only if you run a mirror of the same API.
# Defaults: https://open.er-api.com/v6/latest  |  https://api.frankfurter.app
# FX_PROVIDER_BASE_URL=your_value_here
# open.er-api.com works without a key. Required only for a paid/custom mirror.
FX_PROVIDER_API_KEY=your_value_here
# Hard cap for a provider request, in ms (clamped to 1000–30000; default 6000).
FX_PROVIDER_TIMEOUT_MS=your_value_here
# How long fetched rates are reused, in ms (clamped to 0–24h; default 15 min).
FX_RATE_CACHE_TTL_MS=your_value_here
# Rates older than this many days are flagged as stale in the UI (default 7).
FX_RATE_STALE_DAYS=your_value_here

# ── CRM & Lead Management — Google Sheets OAuth 2.0 Integration ──
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs):
GOOGLE_CLIENT_ID=your_value_here
GOOGLE_CLIENT_SECRET=your_value_here
# Authorized redirect URI configured in Google Cloud Console:
GOOGLE_REDIRECT_URI=your_value_here
# Minimum scopes required:
GOOGLE_SHEETS_SCOPES=your_value_here
